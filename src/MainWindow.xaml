<Window x:Class="ActorPipeline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Width="1054" Height="551">
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Right" Width="250" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Content="Resolution"/>
            <ComboBox Grid.Column="1" x:Name="Resolution"/>
            <Label Grid.Row="1" Content="Dwell"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DwellTime"/>
            <Label Grid.Row="2" Content="Format"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Format"/>
            <Border x:Name="ZoomImageBorder" Grid.Row="3" Grid.ColumnSpan="2" BorderThickness="0" Background="DimGray" Width="240" Height="160" Margin="0,10,0,0">
                <Image x:Name="ZoomImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <Button x:Name="StartStop" Margin="0,10" Grid.Row="9" Grid.ColumnSpan="2" Content="Start" Click="StartStop_Click"/>
        </Grid>
        <Border x:Name="ImageBorder" BorderThickness="0" Background="DimGray">
            <Image x:Name="Image" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   MouseWheel="Image_OnMouseWheel"/>
        </Border>
        
    </DockPanel>
</Window>
