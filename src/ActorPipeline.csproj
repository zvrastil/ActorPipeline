<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Copyright>Copyright © 2022</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.75" />
    <!-- Keep the Serilog adapter's transitive Akka.Hosting on the patched release. -->
    <PackageReference Include="Akka.Hosting" Version="1.5.75" />
    <PackageReference Include="Akka.Logger.Serilog" Version="1.5.69" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="Cloo.clSharp" Version="1.0.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Actors\Downscaling\DownscalingKernels.cl" />
  </ItemGroup>
</Project>
