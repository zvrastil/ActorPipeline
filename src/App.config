<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="akka"
             type="Akka.Configuration.Hocon.AkkaConfigurationSection, Akka" />
  </configSections>

  <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.ObjectPool" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.0.5.0" newVersion="5.0.5.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <akka>
    <hocon>
      <![CDATA[
          akka 
          {
            loglevel = DEBUG
            loggers = ["Akka.Logger.Serilog.SerilogLogger, Akka.Logger.Serilog"]            
          }
          replaceable-message-mailbox 
          {
              mailbox-type : "ActorPipeline.Mailbox.ReplaceableMessageMailbox, ActorPipeline"
          }
      ]]>
    </hocon>
  </akka>

</configuration>